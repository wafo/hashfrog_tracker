{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hashfrog-tracker",
  "compatibility_date": "2026-08-24",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only the API runs the Worker; everything else is served straight from the static assets.
    "run_worker_first": ["/api/*"]
  },
  "ratelimits": [
    {
      // Spent only by settings decodes that miss the cache (see ADR 0001).
      "name": "SETTINGS_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true
  }
}
